			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"// [Global] Content-Type — JSON (только когда есть JSON-тело)",
					"pm.test(\"[Global] Content-Type — JSON (если есть тело)\", () => {",
					"    const code = pm.response.code;",
					"    const body = pm.response.text();",
					"",
					"    if (code === 204) return;",
					"    if (!body || body.trim() === '') return;",
					"    if (code === 401 || code === 403) return;",
					"",
					"    pm.response.to.have.header('Content-Type');",
					"    pm.expect(pm.response.headers.get('Content-Type'))",
					"        .to.include('application/json');",
					"});",
					"",
					"// [Global] Время ответа в разумных пределах",
					"pm.test(\"[Global] Время ответа в разумных пределах\", () => {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"// [Global] Флаг success присутствует в JSON-ответах",
					"pm.test(\"[Global] Флаг success присутствует\", () => {",
					"    const code = pm.response.code;",
					"    const body = pm.response.text();",
					"",
					"    if (code === 204 || code === 401 || code === 403) return;",
					"    if (!body || body.trim() === '') return;",
					"    if (body.trim().startsWith('<')) return;",
					"",
					"    try {",
					"        const j = pm.response.json();",
					"        if (j.statusCode !== undefined && j.success === undefined) return;",
					"        pm.expect(j).to.have.property('success');",
					"        pm.expect(j.success).to.be.a('boolean');",
					"    } catch (e) {",
					"        return;",
					"    }",
					"});"
				]
			}
		}
