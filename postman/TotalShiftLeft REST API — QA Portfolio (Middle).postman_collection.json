		{
			"name": "02_CRUD_Users",
			"item": [
				{
					"name": "2.1 POST /users — Create User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Генерируем уникальные данные для нового пользователя",
									"const timestamp = Date.now();",
									"pm.collectionVariables.set('uniqueName', `User_${timestamp}`);",
									"pm.collectionVariables.set('uniqueEmail', `user_${timestamp}@example.com`);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 201 Created\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Флаг success = true\", () => {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test(\"Ресурс создан с корректной структурой\", () => {",
									"    const user = pm.response.json().data;",
									"",
									"    pm.expect(user).to.be.an('object');",
									"    pm.expect(user).to.have.all.keys(",
									"        'id', 'name', 'email', 'role', 'created_at'",
									"    );",
									"    pm.expect(user.id).to.be.a('string');",
									"    pm.expect(user.name).to.eql(pm.collectionVariables.get('uniqueName'));",
									"    pm.expect(user.email).to.eql(pm.collectionVariables.get('uniqueEmail'));",
									"    pm.expect(user.role).to.eql('user');",
									"    pm.expect(user.created_at).to.be.a('string');",
									"});",
									"",
									"pm.test(\"ID — валидный UUID\", () => {",
									"    const user = pm.response.json().data;",
									"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
									"    pm.expect(user.id).to.match(uuidRegex);",
									"});",
									"",
									"// Сохраняем ID для следующих запросов",
									"pm.collectionVariables.set('userId', pm.response.json().data.id);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"{{uniqueName}}\",\n    \"email\": \"{{uniqueEmail}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						},
						"description": "Создание нового пользователя с динамически сгенерированными данными.\n\nPre-request:\n\n- генерация uniqueName и uniqueEmail на основе Date.now()\n    \n- уникальность гарантирует отсутствие конфликтов при повторных прогонах\n    \n\nЧто проверяется:\n\n- статус 201 Created\n    \n- структура созданного ресурса (id, name, email, role, created_at)\n    \n- валидность UUID\n    \n- соответствие name и email сгенерированным значениям\n    \n\nПобочный эффект: userId сохраняется в Collection Variables  \nдля использования в запросах 2.2–2.4."
					},
					"response": []
				},
				{
					"name": "2.2 GET /users/{{userId}} — Read User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.collectionVariables.get('userId')) {",
									"    throw new Error(",
									"        'Переменная userId не установлена. ' +",
									"        'Запустите коллекцию через Collection Runner, начиная с 02_CRUD_Users.'",
									"    );",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Флаг success = true\", () => {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test(\"Данные пользователя полные\", () => {",
									"    const user = pm.response.json().data;",
									"",
									"    pm.expect(user).to.be.an('object');",
									"    pm.expect(user).to.have.all.keys(",
									"        'id', 'name', 'email', 'role', 'created_at'",
									"    );",
									"    pm.expect(user.id).to.be.a('string');",
									"    pm.expect(user.name).to.be.a('string');",
									"    pm.expect(user.email).to.be.a('string');",
									"});",
									"",
									"pm.test(\"ID совпадает с запрошенным\", () => {",
									"    const user = pm.response.json().data;",
									"    const requestedId = pm.collectionVariables.get('userId');",
									"    pm.expect(user.id).to.eql(requestedId);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "GET",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Чтение созданного пользователя по ID из переменной {{userId}}.\n\nPre-request:\n\n- проверка наличия userId, иначе throw new Error  \n    (защита от запуска запроса вне контекста коллекции)\n    \n\nЧто проверяется:\n\n- статус 200 и флаг success = true\n    \n- полнота и типы полей пользователя\n    \n- совпадение id с запрошенным значением"
					},
					"response": []
				},
				{
					"name": "2.3 PATCH /users/{{userId}} — Update User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.collectionVariables.get('userId')) {",
									"    throw new Error('userId не установлен. Выполните запросы 02.1 и 02.2.');",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Флаг success = true\", () => {",
									"    pm.expect(pm.response.json().success).to.be.true;",
									"});",
									"",
									"pm.test(\"Имя обновлено\", () => {",
									"    const user = pm.response.json().data;",
									"    pm.expect(user.name).to.eql('Updated Name');",
									"});",
									"",
									"pm.test(\"Остальные поля не изменены\", () => {",
									"    const user = pm.response.json().data;",
									"    const originalEmail = pm.collectionVariables.get('uniqueEmail');",
									"",
									"    pm.expect(user.email).to.eql(originalEmail);",
									"    pm.expect(user.role).to.eql('user');",
									"    pm.expect(user.id).to.eql(pm.collectionVariables.get('userId'));",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Name\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Частичное обновление пользователя — изменяется только поле name.\n\nPre-request:\n\n- проверка наличия userId\n    \n\nЧто проверяется:\n\n- статус 200 и флаг success = true\n    \n- имя действительно обновлено\n    \n- остальные поля (email, role, id) не изменились"
					},
					"response": []
				},
				{
					"name": "2.4 DELETE /users/{{userId}} — Delete User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.collectionVariables.get('userId')) {",
									"    throw new Error('userId не установлен. Выполните запросы 02.1–02.3.');",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 204 No Content\", () => {",
									"    pm.response.to.have.status(204);",
									"});",
									"",
									"pm.test(\"Тело ответа пустое\", () => {",
									"    pm.expect(pm.response.text()).to.be.empty;",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}"
							]
						},
						"description": "Удаление созданного пользователя.\n\nPre-request:\n\n- проверка наличия userId\n    \n\nЧто проверяется:\n\n- статус 204 No Content\n    \n- тело ответа пустое\n    \n\nЗавершает CRUD-цикл: ресурс удалён, коллекцию можно запускать заново."
					},
					"response": []
				}
			],
			"description": "Полный CRUD-цикл на ресурсе users: Create → Read → Update → Delete.  \nЗапросы связаны через переменную userId.  \nТребует последовательного запуска."
		},
		{
			"name": "03_Query_Filtering",
			"item": [
				{
					"name": "3.1 GET /products?category=books — Filter",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Флаг success = true\", () => {",
									"    pm.expect(pm.response.json().success).to.be.true;",
									"});",
									"",
									"pm.test(\"Количество товаров не превышает limit\", () => {",
									"    const products = pm.response.json().data;",
									"    pm.expect(products).to.be.an('array');",
									"    pm.expect(products.length).to.be.at.most(5);",
									"});",
									"",
									"pm.test(\"Все товары категории books\", () => {",
									"    const products = pm.response.json().data;",
									"    // Если массив пуст — проверка не должна падать",
									"    if (products.length > 0) {",
									"        products.forEach(product => {",
									"            pm.expect(product.category).to.eql('books');",
									"        });",
									"    }",
									"});",
									"",
									"pm.test(\"Пагинация отражает применённый фильтр\", () => {",
									"    const p = pm.response.json().pagination;",
									"    pm.expect(p.limit).to.eql(5);",
									"    pm.expect(p.page).to.eql(1);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "GET",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/products?category=books&limit=5",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "category",
									"value": "books"
								},
								{
									"key": "limit",
									"value": "5"
								}
							]
						},
						"description": "Проверка работы query-параметров фильтрации.\n\nURL: /products?category=books&limit=5\n\nЧто проверяется:\n\n- статус 200 и флаг success = true\n    \n- количество товаров не превышает limit\n    \n- все товары в ответе относятся к категории books\n    \n- пагинация отражает применённый фильтр (page, limit)"
					},
					"response": []
				},
				{
					"name": "3.2 GET /products?page=2&limit=5 — Pagination",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Статус код 200\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Флаг success = true\", () => {",
									"    pm.expect(pm.response.json().success).to.be.true;",
									"});",
									"",
									"pm.test(\"Пагинация корректно отражает запрошенную страницу\", () => {",
									"    const jsonData = pm.response.json();",
									"    const p = jsonData.pagination;",
									"",
									"    pm.expect(p.page).to.eql(2);",
									"    pm.expect(p.limit).to.eql(5);",
									"    pm.expect(p.hasPrev).to.be.true;",
									"    pm.expect(p.hasNext).to.be.a('boolean');",
									"});",
									"",
									"pm.test(\"Количество товаров не превышает limit\", () => {",
									"    const products = pm.response.json().data;",
									"    pm.expect(products.length).to.be.at.most(5);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products?page=2&limit=5",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "page",
									"value": "2"
								},
								{
									"key": "limit",
									"value": "5"
								}
